# vscode
.vscode

# Intellij
*.iml
.idea

# npm（工程根在 src/）
node_modules/

# 构建产物：bin/exports/ 里除 README.md 外都能重新生成
# （main.js 上传到 GitHub releases，不进版本库）
main.js
bin/exports/main.js
bin/exports/manifest.json
bin/exports/styles.css

# Exclude sourcemaps
*.map

# Generated / bundled files (large, not needed in repo)
*.min.js
*.bundle.js
dist/
build/

# obsidian 自己写的插件设置
data.json

# 本地 AI 工具配置
.claude/

# 本机的部署目标（写着自个儿的 vault 路径，不进版本库；模板是 deploy.local.example.json）
deploy.local.json

# 中间产物（README 说明用途，保留）
data/*
!data/README.md

# 本机草稿 / 临时产物（kf-personal-development：dev/ 不进 git）
dev/
temp/
logs/
*.log

# 本机配置 / 密钥
local.json
local.*.json
!.env.example
.env
.env.*
*.pem
*.key

# Exclude macOS Finder (System Explorer) View States
.DS_Store
